    "/2.0/client_service/search": {
      "post": {
        "tags": [
          "Business Activities"
        ],
        "summary": "Search business activities",
        "description": "Search business activities via query. Please refer to the [Search](#section/API-basics/Search) section for detailed instructions.<br>\nThe following search fields are supported:\n* `name`\n",
        "operationId": "v2SearchBusinessActivities",
        "parameters": [
          {
            "name": "order_by",
            "in": "query",
            "description": "Defines the order of the results. Multiple sort parameters can be combined by using a comma separator. `_asc` and `_desc` can be appended to any parameter to either sort ascending (default) or descending.",
            "required": false,
            "style": "form",
            "explode": false,
            "schema": {
              "enum": [
                "id",
                "name"
              ],
              "type": "string",
              "default": "id"
            },
            "example": "name"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Limit the number of results (max is 2000)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 500,
              "example": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Skip over a number of elements by specifying an offset value for the query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "example": 0
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "v2Search",
                "type": "array",
                "items": {
                  "title": "v2SearchField",
                  "required": [
                    "field",
                    "value"
                  ],
                  "type": "object",
                  "properties": {
                    "field": {
                      "maxLength": 255,
                      "type": "string",
                      "description": "Field which should be search over",
                      "example": "search_field"
                    },
                    "value": {
                      "maxLength": 255,
                      "type": "string",
                      "description": "Value to search for",
                      "example": "search term"
                    },
                    "criteria": {
                      "title": "v2SearchCriteria",
                      "enum": [
                        "=",
                        "equal",
                        "!=",
                        "not_equal",
                        ">",
                        "greater_than",
                        ">=",
                        "greater_equal",
                        "<",
                        "less_than",
                        "<=",
                        "less_equal",
                        "like",
                        "not_like",
                        "is_null",
                        "not_null",
                        "in",
                        "not_in"
                      ],
                      "type": "string",
                      "default": "like",
                      "example": "=",
                      "x-enum-elements": [
                        {
                          "name": "=",
                          "description": "equal"
                        },
                        {
                          "name": "equal",
                          "description": "equal"
                        },
                        {
                          "name": "!=",
                          "description": "not equal"
                        },
                        {
                          "name": "not_equal",
                          "description": "not equal"
                        },
                        {
                          "name": ">",
                          "description": "greater than"
                        },
                        {
                          "name": "greater_than",
                          "description": "greater than"
                        },
                        {
                          "name": ">=",
                          "description": "greater or equal"
                        },
                        {
                          "name": "greater_equal",
                          "description": "greater or equal"
                        },
                        {
                          "name": "<",
                          "description": "less than"
                        },
                        {
                          "name": "less_than",
                          "description": "less than"
                        },
                        {
                          "name": "<=",
                          "description": "less or equal"
                        },
                        {
                          "name": "less_equal",
                          "description": "less or equal"
                        },
                        {
                          "name": "like",
                          "description": "like"
                        },
                        {
                          "name": "not_like",
                          "description": "not like"
                        },
                        {
                          "name": "is_null",
                          "description": "null"
                        },
                        {
                          "name": "not_null",
                          "description": "not null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "title": "ClientService",
                    "required": [
                      "name"
                    ],
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "readOnly": true,
                        "example": 1
                      },
                      "name": {
                        "type": "string",
                        "example": "Project Management"
                      },
                      "default_is_billable": {
                        "type": "boolean",
                        "nullable": true,
                        "example": false
                      },
                      "default_price_per_hour": {
                        "type": "number",
                        "nullable": true,
                        "example": null
                      },
                      "account_id": {
                        "type": "integer",
                        "description": "References an [account object](#operation/ListAccounts)",
                        "nullable": true,
                        "example": null
                      }
                    }
                  },
                  "description": "OK"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Error422",
                  "type": "object",
                  "properties": {
                    "error_code": {
                      "type": "integer",
                      "description": "The status code of the HTTP response",
                      "format": "int32"
                    },
                    "message": {
                      "type": "string",
                      "description": "A message describing the error"
                    }
                  },
                  "example": {
                    "error_code": 422,
                    "message": "Unprocessable Entity"
                  }
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "bearerAuth": [
              "general"
            ]
          }
        ]
      }
