                  "account_id": {
                    "type": "integer",
                    "description": "References an [account object](#operation/ListAccounts)",
                    "nullable": true,
                    "example": null
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "title": "ClientService",
                  "required": [
                    "name"
                  ],
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "readOnly": true,
                      "example": 1
                    },
                    "name": {
                      "type": "string",
                      "example": "Project Management"
                    },
                    "default_is_billable": {
                      "type": "boolean",
                      "nullable": true,
                      "example": false
                    },
                    "default_price_per_hour": {
                      "type": "number",
                      "nullable": true,
                      "example": null
                    },
                    "account_id": {
                      "type": "integer",
