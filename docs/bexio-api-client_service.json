            "style": "form",
            "explode": false,
            "schema": {
              "enum": [
                "id",
                "name"
              ],
              "type": "string",
              "default": "id"
            },
            "example": "name"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Limit the number of results (max is 2000)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 500,
              "example": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Skip over a number of elements by specifying an offset value for the query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "example": 0
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "title": "ClientService",
                    "required": [
                      "name"
                    ],
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "readOnly": true,
                        "example": 1
                      },
                      "name": {
                        "type": "string",
                        "example": "Project Management"
                      },
                      "default_is_billable": {
                        "type": "boolean",
                        "nullable": true,
                        "example": false
                      },
                      "default_price_per_hour": {
                        "type": "number",
                        "nullable": true,
                        "example": null
                      },
                      "account_id": {
                        "type": "integer",
                        "description": "References an [account object](#operation/ListAccounts)",
                        "nullable": true,
                        "example": null
                      }
                    }
                  },
                  "description": "OK"
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": [
          {
            "bearerAuth": [
              "general"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "Business Activities"
        ],
        "summary": "Create business activity",
        "description": "This action creates a new business activity",
        "operationId": "v2CreateBusinessActivity",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "ClientService",
                "required": [
                  "name"
                ],
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "readOnly": true,
                    "example": 1
                  },
                  "name": {
                    "type": "string",
